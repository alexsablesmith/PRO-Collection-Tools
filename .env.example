# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

NEXT_PUBLIC_SUPABASE_URL=https://xcwlshhxtldtpkxqbxzx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhjd2xzaGh4dGxkdHBreHFieHp4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2NDMxNjksImV4cCI6MjA5NDIxOTE2OX0.UYJsJDqoQa416yJNR0V6WIJyk-bcI0EUPWx1FWZK0Z8
# Service role key — server-side only (API Routes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# MFA — set to 'true' in Vercel when ready to enforce two-factor authentication
NEXT_PUBLIC_MFA_REQUIRED=false

# Site URL — used to build invite links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Resend — for sending branded invite emails (resend.com)
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Add these when you set up Twilio and Resend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# ── Assessment Center API (PROMIS CAT) ────────────────────────
# Set NEXT_PUBLIC_AC_ENABLED=true only after credentials are configured and OIDs are populated.
# MOCK_AC=true uses fixture data in local development — never set this in production.
NEXT_PUBLIC_AC_ENABLED=false
MOCK_AC=false
AC_REGISTRATION_OID=
AC_TOKEN=
# Set to 'json' if the AC API accepts JSON POST bodies; default is 'xml'
AC_POST_FORMAT=xml
